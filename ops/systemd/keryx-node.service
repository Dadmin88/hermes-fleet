[Unit]
Description=Hermes Keryx edge node for Fleet
After=network-online.target keryxd.service
Wants=network-online.target keryxd.service

[Service]
Type=simple
EnvironmentFile=%h/.config/hermes-fleet/keryx-node.env
ExecStart=%h/.local/share/hermes-fleet/bin/keryx-node
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/hermes-fleet %h/.config/hermes-fleet

[Install]
WantedBy=default.target
