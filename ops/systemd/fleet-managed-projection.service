[Unit]
Description=Hermes Fleet managed-projection local control
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Provision the exact socket and database parent directories before this unit.
# Fleet rejects symlinked, missing, non-service-owned, or permissive parents.
# The supplied user unit is same-UID by default: the environment file needs
# socket, database, and allowed UID only. See the documented drop-in for the
# explicit cross-UID group socket mode.
EnvironmentFile=%h/.config/hermes-fleet/fleet-managed-projection.env
ExecStart=%h/.local/share/hermes-fleet/venv/bin/fleet-managed-projection --socket ${FLEET_MANAGED_PROJECTION_SOCKET} --database ${FLEET_MANAGED_PROJECTION_DATABASE} --allowed-uid ${FLEET_MANAGED_PROJECTION_ALLOWED_UID} --shutdown-timeout 20 --log-level INFO
UMask=0077
Restart=on-failure
RestartSec=5
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=default.target
